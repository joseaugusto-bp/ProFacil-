# Desenvolvimento temporário: Supabase compartilhado (somente dados fictícios).
# Copie host/usuário do Connect > Session pooler; codifique caracteres especiais da senha.
# Estes são placeholders, não credenciais reais.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@HOST_DO_SESSION_POOLER:5432/postgres?schema=public&sslmode=require&connection_limit=2"
# Prisma 5: Session pooler também atende às migrações; não usar Transaction pooler aqui.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@HOST_DO_SESSION_POOLER:5432/postgres?schema=public&sslmode=require"
FRONTEND_ORIGIN="http://localhost:5173"
PORT=3000
NODE_ENV=development
# Só o responsável aplica migrações e provisiona o primeiro coordenador.
# ADMIN_EMAIL, ADMIN_NAME e ADMIN_PASSWORD são configuradas temporariamente no bootstrap.
# Não definir RUN_DATABASE_TESTS=1 com as conexões compartilhadas.
