{
  "name": "profacil-backend",
  "version": "1.0.0",
  "description": "API RESTful do sistema Profacil",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "node scripts/check-generated.cjs && tsc",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "prebuild": "npm run prisma:generate",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "start": "node dist/server.js",
    "bootstrap": "ts-node src/scripts/bootstrap.ts",
    "predev": "npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "nodemon": "^3.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">=24"
  }
}
